{
  "_id": "BnWw21bXnKRXdeny",
  "name": "幻奏琴长弓 Longbow of Melodies (BMT)",
  "type": "weapon",
  "system": {
    "source": {
      "custom": "",
      "book": "BMT",
      "page": "66",
